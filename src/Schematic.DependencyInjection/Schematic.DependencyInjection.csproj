    <ItemGroup>
        <InternalsVisibleTo Include="Schematic.AspNetCore.Tests" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="SchematicHQ.Client" />
      <PackageReference Include="ZiggyCreatures.FusionCache" />
    </ItemGroup>

    <Import Project="../../Package.Build.props" />

</Project>
