<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>Quartz.NET integration for Schematic entitlement management: gate and track scheduled jobs via attributes, and schedule recurring trait reports.</Description>
        <PackageTags>metering;quartz;scheduling</PackageTags>
        <!-- Quartz 4 ships net10.0 only. -->
        <TargetFrameworks>net10.0</TargetFrameworks>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SchematicHQ.Community.AspNetCore.Tests" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\SchematicHQ.Community.DependencyInjection\SchematicHQ.Community.DependencyInjection.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Quartz" />
    </ItemGroup>

    <Import Project="../../Package.Build.props" />

</Project>
