<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>Microsoft.Extensions.AI integration for Schematic entitlement management: meter chat token usage as Schematic Track events and gate model calls behind entitlements.</Description>
        <PackageTags>metering;ai;ichatclient</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\SchematicHQ.Community.AspNetCore\SchematicHQ.Community.AspNetCore.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.AI" />
    </ItemGroup>

    <!-- Ships the repo's agent skill in the package at skills/<name>/SKILL.md, where package-skill tools look for it. -->
    <ItemGroup>
        <None Include="..\..\.claude\skills\schematic-ai-usage-metering\**"
              Pack="true"
              PackagePath="skills\schematic-ai-usage-metering\%(RecursiveDir)"
              Visible="false" />
    </ItemGroup>

    <Import Project="../../Package.Build.props" />

</Project>
